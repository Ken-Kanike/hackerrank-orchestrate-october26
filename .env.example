# Copy to .env and fill in. Every provider/key is optional; the router uses whatever is present.
# Provider priority, best first. Missing providers are skipped. With no keys the pipeline runs fully offline (deterministic).
LLM_PROVIDER_ORDER=anthropic,openai,gemini,groq

# Groq (free tier). Add as many keys as you have: GROQ_API_KEY_1..N (rotated when one is rate-limited/exhausted).
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
# MODEL1 = preferred, MODEL2 = fallback. Defaults: openai/gpt-oss-120b, openai/gpt-oss-20b
GROQ_API_KEY_MODEL1=
GROQ_API_KEY_MODEL2=
# Vision-capable Groq model for screenshots (default qwen/qwen3.8-27b)
GROQ_VISION_MODEL=

# Anthropic (Claude). Defaults: claude-opus-5-5 / claude-sonnet-5-5
ANTHROPIC_API_KEY_1=
ANTHROPIC_MODEL1=
ANTHROPIC_MODEL2=

# OpenAI (GPT). Defaults: gpt-4.1 / gpt-4.1-mini
OPENAI_API_KEY_1=
OPENAI_MODEL1=
OPENAI_MODEL2=

# Google Gemini. Defaults: gemini-2.5-pro / gemini-2.5-flash
GEMINI_API_KEY_1=
GEMINI_MODEL1=
GEMINI_MODEL2=
